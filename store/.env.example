# NestPaw — copy to .env.local and fill in values
# https://dashboard.stripe.com/apikeys

# Stripe — local/test keys (used automatically in development)
STRIPE_SECRET_KEY_LOCAL=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LOCAL=pk_test_...
STRIPE_WEBHOOK_SECRET_LOCAL=whsec_...

# Stripe — live keys (used automatically in production/preview)
STRIPE_SECRET_KEY_LIVE=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...
STRIPE_WEBHOOK_SECRET_LIVE=whsec_...

# Optional legacy fallbacks (used if the env-specific vars above are unset)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Stripe success/cancel redirect URLs
# Production / Preview (Vercel): https://shopnestpaw.com
NEXT_PUBLIC_SITE_URL=https://shopnestpaw.com
# Local development only — used automatically when NODE_ENV=development
NEXT_PUBLIC_SITE_URL_LOCAL=http://localhost:3000

# Contact form + shipping notifications (https://resend.com)
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=hello@shopnestpaw.com
# Use a verified domain sender so shipping emails can reach customers
CONTACT_FROM_EMAIL=NestPaw <hello@shopnestpaw.com>

# Postgres — Neon on Vercel (or local Postgres for development)
# vercel integration add neon --plan free_v3
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# Internal admin (/admin) — use a long random password (16+ chars)
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Strongly recommended in production — random secret separate from the password
ADMIN_SESSION_SECRET=

# Storefront analytics (@vercel/analytics) runs automatically on Vercel.
# View traffic in the Vercel project dashboard if needed.
