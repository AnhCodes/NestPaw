# NestPaw — copy to .env.local and fill in values
# https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret (create in Stripe Dashboard / Workbench)
STRIPE_WEBHOOK_SECRET=whsec_...

# Used for Stripe success/cancel redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (https://resend.com)
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=you@example.com
# Optional — use a verified domain sender in production
CONTACT_FROM_EMAIL=NestPaw <hello@shopnestpaw.com>

# Postgres — Neon on Vercel (or local Postgres for development)
# vercel integration add neon --plan free_v3
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# Internal admin (/admin)
ADMIN_PASSWORD=change-me
# Optional — defaults derived from ADMIN_PASSWORD if unset
ADMIN_SESSION_SECRET=

# Vercel Analytics
# Add @vercel/analytics to track pageviews automatically.
# For live analytics inside /admin, provide a Vercel API token.
VERCEL_API_TOKEN=
# Optional overrides; on Vercel these can come from system env vars.
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=
