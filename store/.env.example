# NestPaw — copy to .env.local and fill in values
# https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret (create in Stripe Dashboard / Workbench)
STRIPE_WEBHOOK_SECRET=whsec_...

# Used for Stripe success/cancel redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (https://resend.com)
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=you@example.com
# Optional — use a verified domain sender in production
CONTACT_FROM_EMAIL=NestPaw <hello@shopnestpaw.com>
